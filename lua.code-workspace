{
    "folders": [
        {
            // 你的主要代码目录
            "path": "."
        },
        {
            // 【关键修改】直接指向 CraftOS 的物理数据存储位置
            // 这样既能看到电脑0的文件，又是标准的物理路径，不会触发无限扫描Bug
            // 请将 william_lv 替换为你实际的用户名（如果不同）
            "name": "Computer 0 (Local)",
            "path": "C:/Users/william_lv/AppData/Roaming/CraftOS-PC/Computer/0"
        }
    ],
    "settings": {
        // 专门针对此项目的 Lua 配置
        "Lua.runtime.version": "Lua 5.1",
        // 告诉 Lua 插件这是 ComputerCraft 环境，自动识别全局变量
        "Lua.diagnostics.globals": [
            "turtle",
            "term",
            "fs",
            "http",
            "os",
            "textutils",
            "parallel",
            "paintutils",
            "redstone",
            "peripheral",
            "colors",
            "commands",
            "shell",
            "disk",
        ],
        // 彻底禁止扫描无用的系统文件夹
        "Lua.workspace.ignoreDir": [
            "**/rom", // 忽略只读的 ROM 文件，避免干扰
            "**/.vscode",
            "**/.git",
        ],
        // 优化性能，只加载必要的库
        "Lua.workspace.checkThirdParty": false
    }
}